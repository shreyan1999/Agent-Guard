# The Fluent icon package ships source maps that point at paths not present
# in the published tarball, so CRA's source-map-loader logs ~109 warnings on
# every rebuild. Turning it off silences those; dev still gets
# cheap-module-source-map from webpack devtool, which is not gated by this.
GENERATE_SOURCEMAP=false

# This file is COMMITTED. Do not put a token here.
#
# REACT_APP_API_TOKEN is read by src/api.js as a bearer credential. Put it in
# .env.local (gitignored) instead — or better, use localStorage['agt_api_token']
# at runtime, because every REACT_APP_* value is inlined into the built bundle
# at compile time and is readable by anyone who can load the page.
